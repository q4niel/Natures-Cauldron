{
	"schemaVersion": 1,
	"id": "natures_cauldron",
	"version": "${version}",
	"name": "Natures Cauldron",
	"description": "Revamping potion brewing with flowers",
	"authors": ["q4niel"],
    "contributors": ["MaxWesterlund (Art Assets)"],
	"contact": {
		"homepage": "https://modrinth.com/mod/natures-cauldron",
		"sources": "https://github.com/q4niel/Natures-Cauldron",
        "issues": "https://github.com/q4niel/Natures-Cauldron/issues"
	},
	"license": "Natures Cauldron License",
	"icon": "assets/natures_cauldron/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "dev.q4niel.NaturesCauldron",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "dev.q4niel.NaturesCauldronClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "dev.q4niel.NaturesCauldronDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"natures_cauldron.mixins.json",
		{
			"config": "natures_cauldron.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}